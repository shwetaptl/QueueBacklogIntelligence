# Azure Storage — get from Azure Portal (both vars use the same connection string)
AzureWebJobsStorage=your-storage-connection-string-here
StorageConnectionString=your-storage-connection-string-here

# Azure Service Bus — get from Azure Portal
ServiceBusConnectionString=your-servicebus-connection-string-here

# Azure Functions
FUNCTIONS_WORKER_RUNTIME=dotnet-isolated

# Email alerts (optional — leave blank to disable)
SmtpHost=smtp.gmail.com
SmtpPort=587
SmtpUser=your-email@gmail.com
SmtpPassword=your-app-password
SmtpFromAddress=your-email@gmail.com

# Frontend authentication (Azure AD / Entra ID)
# Set VITE_AUTH_ENABLED=false for local development to bypass login
VITE_AUTH_ENABLED=true
VITE_AZURE_CLIENT_ID=<SPA Application (client) ID from Azure AD app registration>
VITE_AZURE_TENANT_ID=<Directory (tenant) ID from Azure AD>
VITE_AZURE_API_SCOPE=api://<API Application (client) ID>/access_as_user
